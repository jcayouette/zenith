#!/usr/bin/env bash
# GPIO dew pad on BCM 17 (header pin 11). USB-A VBUS is NEVER cut.
# On Pi 5 the Active Cooler 5 V is downstream of USB_VBUS_EN — uhubctl off kills the fan.
#
#   ./scripts/dew-heater on|off|status
#   ./scripts/dew-heater usb-on    # emergency: force USB VBUS on (fan rail)

set -euo pipefail

PINCTRL=${PINCTRL:-/usr/bin/pinctrl}
PIN=${DEW_GPIO:-17}

die() { echo "dew-heater: $*" >&2; exit 1; }

usb_on() {
  local loc ok=0
  command -v uhubctl >/dev/null 2>&1 || return 0
  for loc in 1 2 3 4; do
    if [ "$(id -u)" -eq 0 ]; then
      uhubctl -l "$loc" -a 1 >/dev/null 2>&1 && ok=1
    else
      sudo -n uhubctl -l "$loc" -a 1 >/dev/null 2>&1 && ok=1 || true
    fi
  done
  return 0
}

gpio_set() {
  local level=$1
  [ -x "$PINCTRL" ] || die "pinctrl not found"
  "$PINCTRL" set "$PIN" op "$level"
}

cmd_status() {
  echo "USB VBUS: locked ON (Pi 5 fan). Never switched."
  if command -v uhubctl >/dev/null 2>&1; then
    if [ "$(id -u)" -eq 0 ]; then uhubctl || true
    else sudo -n uhubctl || true
    fi
  fi
  echo
  echo "Dew relay Signal BCM ${PIN} (header pin 11, active-low):"
  "$PINCTRL" get "$PIN" || true
}

usage() {
  cat <<'EOF'
Usage: dew-heater on|off|status|usb-on

  on       GPIO 17 low — heater on (active-low relay). USB stays on.
  off      GPIO 17 high — heater off. USB stays on.
  status   Show USB (should be powered) and GPIO 17
  usb-on   Force USB-A VBUS on if the fan is dead after an old off command

There is no usb-off. Do not add one.
EOF
}

usb_on
case "${1:-}" in
  on) gpio_set dl ;;
  off) gpio_set dh ;;
  status) cmd_status ;;
  usb-on) echo "USB VBUS forced on." ;;
  -h|--help|help|"") usage ;;
  *) usage; exit 1 ;;
esac
